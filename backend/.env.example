# Copy to .env and fill in. Provided by the challenge.
# (Voice and model live in the agent JSON, e.g. example_flow.json, not here.)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Optional Copilot and text-simulation settings
COPILOT_MODEL=gpt-4o
CALLER_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
# Review flagged or malformed judgments; leave empty to disable.
JUDGE_REVIEW_MODEL=gpt-4o
SIM_MAX_TURNS=8
SIM_CONCURRENCY=5
SIM_MAX_RUNS=10
